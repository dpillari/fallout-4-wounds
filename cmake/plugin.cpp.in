// Generated by CMake: tells F4SE the plugin's name and version.
#include <F4SE/F4SE.h>

F4SE_PLUGIN_VERSION = []() noexcept {
	F4SE::PluginVersionData v{};
	v.PluginVersion({ @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, 0 });
	v.PluginName("@PROJECT_NAME@");
	v.AuthorName("WoundMeshes");
	v.UsesSigScanning(false);
	v.UsesAddressLibrary(true);
	v.HasNoStructUse(false);
	v.IsLayoutDependent(true);
	v.CompatibleVersions({ F4SE::RUNTIME_LATEST });
	v.MinimumRequiredXSEVersion({ 0, 0, 0, 0 });
	return v;
}();
